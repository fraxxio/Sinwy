{
	"name": "sinwy",
	"workspaces": [
		"Sinwy.*"
	],
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun run start:server & bun run start:web",
		"start:web": "cd Sinwy.WebFrontend && bun start",
		"start:server": "cd Sinwy.Backend && bun start",
		"start:localproxy": "ngrok start sinwy",
		"build": "bun run build:web",
		"build:web": "cd Sinwy.WebFrontend && bun run build",
		"test": "bun run test:server && bun run test:web && bun run test:scripts",
		"test:web": "cd Sinwy.WebFrontend && bun test",
		"test:server": "cd Sinwy.Backend && bun test",
		"test:scripts": "bun test ./scripts",
		"typecheck": "tsc --noEmit -p Sinwy.Shared && tsc --noEmit -p Sinwy.Backend && tsc --noEmit -p Sinwy.WebFrontend && tsc --noEmit -p scripts",
		"typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput -p Sinwy.Backend & tsc --noEmit --watch --preserveWatchOutput -p Sinwy.WebFrontend",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "biome format .",
		"format:check": "biome format . --check",
		"check": "biome check .",
		"check:fix": "biome check . --write",
		"verify": "bun run scripts/verify.ts",
		"verify:full": "bun run check && bun run skills:check && bun run typecheck && bun run test",
		"skills:check": "bun run scripts/checkSkills.ts",
		"skills:link": "bun run scripts/linkSkills.ts",
		"db:up": "docker compose -f ./Sinwy.Backend/docker-compose.yml up -d",
		"db:down": "docker compose -f ./Sinwy.Backend/docker-compose.yml down",
		"db:migrate": "cd Sinwy.Backend && bunx drizzle-kit migrate",
		"db:generate": "cd Sinwy.Backend && bunx drizzle-kit generate",
		"db:ui": "cd Sinwy.Backend && bunx drizzle-kit studio",
		"db:agent:setup": "cd Sinwy.Backend && bun run scripts/setupAgentDb.ts",
		"db:purge-organizations": "bun run Sinwy.Backend/scripts/purgeOrganizations.ts",
		"db:transfer-organization": "bun run Sinwy.Backend/scripts/transferOrganization.ts",
		"dev:login-as": "bun run Sinwy.Backend/scripts/dev/loginAs.ts",
		"dev:last-email": "bun run Sinwy.Backend/scripts/dev/lastEmail.ts",
		"dev:capture-polar-fixture": "bun run Sinwy.Backend/scripts/dev/capturePolarFixture.ts",
		"dev:simulate-polar-webhook": "bun run Sinwy.Backend/scripts/dev/simulatePolarWebhook.ts",
		"dev:seed-scenario": "bun run Sinwy.Backend/scripts/dev/seedScenario.ts",
		"auth:schema:generate": "bunx --bun auth@latest generate --config Sinwy.Backend/modules/auth/auth.ts"
	},
	"dependencies": {
		"better-auth": "^1.7.12",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@playwright/cli": "^0.1.22",
		"@types/bun": "^1.4.3",
		"chrome-devtools-mcp": "^1.11.0",
		"shadcn": "^4.13.0"
	},
	"peerDependencies": {
		"typescript": "6.0.3"
	}
}
