{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"paths": {
			"@db": ["./db"],
			"@db/*": ["./db/*"],
			"@config": ["./lib/appConfig.ts"],
			"@logger": ["./lib/logger"],
			"@authModule": ["./modules/auth"],
			"@organizationsModule": ["./modules/organizations"],
			"@userModule": ["./modules/user"],
			"@backend/*": ["./*"]
		}
	},
	"include": ["**/*.ts"]
}
