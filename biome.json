{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/routeTree.gen.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"useAwait": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useConst": "error",
				"useImportType": "error",
				"useExportType": "error",
				"noInferrableTypes": "error",
				"useNodejsImportProtocol": "error",
				"useTemplate": "error",
				"noYodaExpression": "error",
				"useCollapsedElseIf": "error",
				"useShorthandAssign": "error"
			},
			"complexity": {
				"noUselessStringConcat": "error",
				"noForEach": "off",
				"useLiteralKeys": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/shared/components/ui/**"],
			"linter": { "enabled": false }
		},
		{
			"includes": ["**/src/styles.css"],
			"linter": {
				"rules": {
					"complexity": { "noImportantStyles": "off" }
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
